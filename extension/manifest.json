{
    "manifest_version": 3,
    "name": "Shopping Intelligence",
    "version": "0.3.0",
    "description": "Sebelum checkout, cek dulu — hemat duit, nggak nyesel.",
    "permissions": [
        "activeTab",
        "tabs",
        "storage",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "https://*.shopee.co.id/*",
        "https://shopee.co.id/*",
        "https://shopee.co.id/search*",
        "https://*.tokopedia.com/*",
        "https://tokopedia.com/*",
        "https://www.tokopedia.com/search*",
        "https://*.lazada.co.id/*",
        "https://lazada.co.id/*",
        "https://www.lazada.co.id/catalog*",
        "https://*.blibli.com/*",
        "https://blibli.com/*",
        "https://www.blibli.com/cari*",
        "https://api.exa.ai/*",
        "https://api.groq.com/*",
        "http://localhost:3000/*"
    ],
    "action": {
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Shopping Intelligence Companion"
    },
    "side_panel": {
        "default_path": "sidepanel/sidepanel.html"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.shopee.co.id/*",
                "https://shopee.co.id/*",
                "https://*.tokopedia.com/*",
                "https://tokopedia.com/*",
                "https://*.lazada.co.id/*",
                "https://lazada.co.id/*",
                "https://*.blibli.com/*",
                "https://blibli.com/*"
            ],
            "js": [
                "shared/constant.js",
                "adapters/base-adapter.js",
                "adapters/shopee-adapter.js",
                "adapters/tokopedia-adapter.js",
                "adapters/lazada-adapter.js",
                "adapters/blibli-adapter.js",
                "shared/ai-client.js",
                "content/marketplace-detector.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://shopee.co.id/search*",
                "https://*.shopee.co.id/search*",
                "https://www.tokopedia.com/search*",
                "https://*.tokopedia.com/search*",
                "https://www.lazada.co.id/catalog*",
                "https://*.lazada.co.id/catalog*",
                "https://www.blibli.com/cari*",
                "https://*.blibli.com/cari*"
            ],
            "js": [
                "content/native-search-parser.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background/service-worker.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}
