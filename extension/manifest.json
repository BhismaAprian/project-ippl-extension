{
    "manifest_version": 3,
    "name": "Shopping Intelligence",
    "version": "0.1.0",
    "description": "Sebelum checkout, cek dulu — hemat duit, nggak nyesel.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting"
    ],
    "host_permissions": [
        "https://shopee.co.id/*",
        "https://www.tokopedia.com/*",
        "https://www.lazada.co.id/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        },
        "default_title": "Shopping Intelligence"
    },
    "content_scripts": [
        {
            "matches": [
                "https://shopee.co.id/*",
                "https://www.tokopedia.com/*",
                "https://www.lazada.co.id/*"
            ],
            "js": [
                "shared/constant.js",
                "adapters/base-adapter.js",
                "adapters/shopee-adapter.js",
                "adapters/tokopedia-adapter.js",
                "adapters/lazada-adapter.js",
                "shared/ai-client.js",
                "content/marketplace-detector.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "background": {
        "service_worker": "background/service-worker.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}